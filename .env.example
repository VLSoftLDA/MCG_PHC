# Configuração de acesso ao SQL Server do PHC
# Copiar para .env e preencher (o .env não vai para o git)

PHC_SQL_SERVER=servidor\instancia
PHC_SQL_PORT=1433
PHC_SQL_USER=utilizador
PHC_SQL_PASSWORD=password

# Opções de ligação
PHC_SQL_ENCRYPT=false
PHC_SQL_TRUST_SERVER_CERTIFICATE=true
PHC_SQL_TIMEOUT=30
